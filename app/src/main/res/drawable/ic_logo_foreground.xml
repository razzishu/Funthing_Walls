    <!-- Outer Glow / Shadow -->
    <path
        android:pathData="M54,54m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="44"
                android:type="radial">
                <item android:color="#4DFF007F" android:offset="0" />
                <item android:color="#00FF007F" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Glass Circle -->
    <path
        android:pathData="M54,54m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:color="#33FFFFFF" android:offset="0" />
                <item android:color="#1AFFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
        <android:strokeWidth android:value="1" />
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:color="#80FFFFFF" android:offset="0" />
                <item android:color="#20FFFFFF" android:offset="1" />
            </gradient>
