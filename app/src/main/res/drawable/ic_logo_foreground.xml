            <gradient
                android:startX="32"
                android:startY="38"
                android:endX="48"
                android:endY="70"
                android:type="linear">
                <item android:color="#FF007F" android:offset="0" />
                <item android:color="#FF00FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized "T" -->
    <path
        android:pathData="M48,38 L64,38 L64,44 L59,44 L59,70 L53,70 L53,44 L48,44 Z">
