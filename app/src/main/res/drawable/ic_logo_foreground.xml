            <gradient
                android:startX="48"
                android:startY="38"
                android:endX="64"
                android:endY="70"
                android:type="linear">
                <item android:color="#7F00FF" android:offset="0" />
                <item android:color="#007FFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized "W" -->
    <path
        android:pathData="M64,38 L70,38 L73,60 L76,38 L82,38 L78,70 L72,70 L69,48 L66,70 L60,70 Z">
