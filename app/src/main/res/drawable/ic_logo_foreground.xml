                android:type="linear">
                <item android:color="#00FFFF" android:offset="0" />
                <item android:color="#007FFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass Highlight Reflection -->
    <path
        android:pathData="M30,30 Q54,15 78,30"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="25"
                android:endX="78"
                android:endY="25"
                android:type="linear">
                <item android:color="#00FFFFFF" android:offset="0" />
                <item android:color="#B3FFFFFF" android:offset="0.5" />
